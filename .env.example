# Cookies from a logged-in x.com browser session (DevTools > Application > Cookies > https://x.com)
X_AUTH_TOKEN=
X_CT0=

# Password for the litex login screen, and a long random secret for signing sessions
APP_PASSWORD=
SESSION_SECRET=

PORT=8787
# X_MOCK=1      # serve fake data (no cookies needed) for UI testing
# NO_AUTH=1     # skip the password gate (local use only)
# COOKIE_SECURE=1  # force Secure session cookie (set automatically behind https proxies)
